NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
RUN_WORKER_IN_API=false

# PostgreSQL, Redis, Elasticsearch
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# Auth & Token Encryption
JWT_SECRET=replace-with-a-secure-random-secret-at-least-32-chars
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
COOKIE_DOMAIN=localhost

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Slack OAuth v2
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback

# Worker, Delays & Rate Limits
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=100
MAX_EMAILS_PER_HOUR=500
STALE_PROCESSING_THRESHOLD_MS=300000
DRY_RUN=false

# Bull Board Admin
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=changeme
